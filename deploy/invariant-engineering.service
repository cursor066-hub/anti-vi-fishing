# Review-only single-host staging unit. No live deployment was executed.
[Unit]
Description=Invariant Fabric isolated engineering gate
After=network.target

[Service]
Type=simple
User=invariant
Group=invariant
WorkingDirectory=/opt/invariant-fabric
# --origin must equal the nginx server_name pair — without it every request
# fails the Host check (w9-deploy F8). --trust-proxy honours X-Forwarded-For
# from the loopback nginx for rate-limit buckets.
ExecStart=/usr/bin/node /opt/invariant-fabric/src/cli.mjs serve --dir /var/lib/invariant-fabric --port 8080 --origin https://invariant.internal --trust-proxy
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
# Resource ceilings — a runaway fabric must not starve the host (w9-deploy F8).
MemoryMax=1G
TasksMax=64
LimitNOFILE=4096
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/invariant-fabric
RestrictSUIDSGID=true
LockPersonality=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
